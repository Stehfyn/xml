// Icons of the CDS Editor shell extension, by index: 0 the product icon Explorer shows for the
// DLL, 1 the Definition File badge, 2 the configuration badge.
#include <windows.h>
#include "../examples/arinc661_version.h"

1 ICON "../examples/cds_editor.ico"
2 ICON "cds_overlay_definition.ico"
3 ICON "cds_overlay_configuration.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 PRODUCTVERSION ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ARINC661_EDITOR_COMPANY_NAME
            VALUE "FileDescription",  "CDS Editor shell extension"
            VALUE "FileVersion",      ARINC661_EDITOR_VERSION_TEXT
            VALUE "InternalName",     "cds_shell"
            VALUE "OriginalFilename", "cds-shell.dll"
            VALUE "ProductName",      ARINC661_EDITOR_PRODUCT_NAME
            VALUE "ProductVersion",   ARINC661_EDITOR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
