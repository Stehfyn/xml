// Application icon and version resource of CDS Editor.
#include <windows.h>
#include "arinc661_version.h"

#define ARINC661_EDITOR_ICON_ID 1

ARINC661_EDITOR_ICON_ID ICON "cds_editor.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 PRODUCTVERSION ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ARINC661_EDITOR_COMPANY_NAME
            VALUE "FileDescription",  "CDS Editor"
            VALUE "FileVersion",      ARINC661_EDITOR_VERSION_TEXT
            VALUE "InternalName",     "cds_editor"
            VALUE "OriginalFilename", "cds-editor.exe"
            VALUE "ProductName",      ARINC661_EDITOR_PRODUCT_NAME
            VALUE "ProductVersion",   ARINC661_EDITOR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
