// CDS Editor setup: icon, the embedded package and license, the wizard dialogs. The banner and
// side images are painted at run time from the icon.
// Dialog units follow the dialog font (Segoe UI 9), so pages scale with the system DPI.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "../examples/arinc661_version.h"

IDI_SETUP          ICON    "../examples/cds_editor.ico"
IDR_LICENSE        RCDATA  "../LICENSE"
IDR_PACKAGE        RCDATA  CDS_SETUP_PACKAGE_PATH

1 24 "cds_setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 PRODUCTVERSION ARINC661_EDITOR_VERSION_MAJOR,ARINC661_EDITOR_VERSION_MINOR,ARINC661_EDITOR_VERSION_PATCH,ARINC661_EDITOR_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ARINC661_EDITOR_COMPANY_NAME
            VALUE "FileDescription",  "CDS Editor Setup"
            VALUE "FileVersion",      ARINC661_EDITOR_VERSION_TEXT
            VALUE "InternalName",     "cds_setup"
            VALUE "OriginalFilename", "cds-setup.exe"
            VALUE "ProductName",      ARINC661_EDITOR_PRODUCT_NAME
            VALUE "ProductVersion",   ARINC661_EDITOR_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Frame: the window every page lives in. Pages fill the area above the bottom line.
// Heights follow the dialog font: text 8-10, check boxes 10, edits 12, buttons 14 units.
IDD_FRAME DIALOGEX 0, 0, 292, 203
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "CDS Editor Setup"
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PAGE_AREA, "Static", SS_LEFT | NOT WS_VISIBLE, 0, 0, 292, 173
    CONTROL         "", IDC_BOTTOM_LINE, "Static", SS_ETCHEDHORZ, 0, 175, 292, 1
    PUSHBUTTON      "< &Back", IDC_BACK, 122, 184, 50, 14
    DEFPUSHBUTTON   "&Next >", IDC_NEXT, 175, 184, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 232, 184, 50, 14
END

// Welcome: side image and the greeting
IDD_WELCOME DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_SIDE_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 173
    LTEXT           "Welcome to the CDS Editor Setup Wizard", IDC_HEADLINE, 107, 16, 175, 37
    LTEXT           "Version", IDC_VERSION, 107, 58, 175, 12
    LTEXT           "The Setup Wizard will install CDS Editor on your computer. Click Next to continue or Cancel to exit the Setup Wizard.", IDC_BODY, 107, 76, 175, 83
END

// License: banner, the text, and acceptance
IDD_LICENSE DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 35
    LTEXT           "License Agreement", IDC_TITLE, 12, 5, 210, 14
    LTEXT           "Please read the following license agreement carefully.", IDC_DESCRIPTION, 20, 20, 222, 10
    CONTROL         "", IDC_BANNER_LINE, "Static", SS_ETCHEDHORZ, 0, 35, 292, 1
    EDITTEXT        IDC_LICENSE_TEXT, 16, 43, 259, 102, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    CONTROL         "I &accept the terms in the License Agreement", IDC_ACCEPT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 151, 259, 10
END

// Options: shortcuts, Explorer integration, after install
IDD_OPTIONS DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 35
    LTEXT           "Select Additional Tasks", IDC_TITLE, 12, 5, 210, 14
    LTEXT           "Select the additional tasks you would like Setup to perform.", IDC_DESCRIPTION, 20, 20, 222, 10
    CONTROL         "", IDC_BANNER_LINE, "Static", SS_ETCHEDHORZ, 0, 35, 292, 1
    LTEXT           "Additional shortcuts:", IDC_GROUP_SHORTCUTS, 20, 44, 250, 10
    CONTROL         "Create a &Start menu shortcut", IDC_OPT_STARTMENU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 58, 240, 10
    CONTROL         "Create a &desktop shortcut", IDC_OPT_DESKTOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 72, 240, 10
    LTEXT           "Windows Explorer:", IDC_GROUP_EXPLORER, 20, 90, 250, 10
    CONTROL         "Add CDS Editor to the &Open With list of all .xml and .bin files", IDC_OPT_OPENWITH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 104, 240, 10
    LTEXT           "Listed for every .xml and .bin file. CDS Editor opens only Definition Files and configurations; default programs are unchanged.", IDC_OPT_OPENWITH_NOTE, 44, 115, 228, 18
    CONTROL         "Show &icons for Definition Files and configurations in Explorer", IDC_OPT_SHELL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 32, 136, 240, 10
    LTEXT           "Only files whose content matches; other .xml and .bin files are unaffected. Adds an Open in CDS Editor command. Takes effect after Explorer restarts.", IDC_OPT_SHELL_NOTE, 44, 147, 228, 18
END

// Destination folder and the files that go there
IDD_FOLDER DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 35
    LTEXT           "Destination Folder", IDC_TITLE, 12, 5, 210, 14
    LTEXT           "Click Next to install here or Change to choose another folder.", IDC_DESCRIPTION, 20, 20, 222, 10
    CONTROL         "", IDC_BANNER_LINE, "Static", SS_ETCHEDHORZ, 0, 35, 292, 1
    LTEXT           "Install CDS Editor to:", IDC_FOLDER_LABEL, 16, 42, 210, 9
    EDITTEXT        IDC_FOLDER, 16, 54, 210, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "&Change...", IDC_BROWSE, 232, 53, 43, 14
    GROUPBOX        "Files to be installed", IDC_GROUP_FILES, 16, 73, 259, 94
    CONTROL         "", IDC_FILE_LIST, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | WS_TABSTOP | WS_BORDER, 23, 84, 245, 77
END

// Ready: the summary
IDD_READY DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 35
    LTEXT           "Ready to Install", IDC_TITLE, 12, 5, 210, 14
    LTEXT           "Setup is now ready to begin installing CDS Editor on your computer.", IDC_DESCRIPTION, 20, 20, 222, 10
    CONTROL         "", IDC_BANNER_LINE, "Static", SS_ETCHEDHORZ, 0, 35, 292, 1
    LTEXT           "Click Install to continue with the installation, or click Back if you want to review or change any settings.", IDC_BODY, 16, 46, 259, 18
    EDITTEXT        IDC_SUMMARY, 16, 68, 259, 96, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
END

// Progress: what the installer is doing
IDD_PROGRESS DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_BANNER_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 35
    LTEXT           "Installing CDS Editor", IDC_TITLE, 12, 5, 210, 14
    LTEXT           "Please wait while the Setup Wizard installs CDS Editor.", IDC_DESCRIPTION, 20, 20, 222, 10
    CONTROL         "", IDC_BANNER_LINE, "Static", SS_ETCHEDHORZ, 0, 35, 292, 1
    LTEXT           "Preparing...", IDC_PROGRESS_ACTION, 16, 76, 259, 10
    CONTROL         "", IDC_PROGRESS_BAR, "msctls_progress32", PBS_SMOOTH, 16, 90, 259, 12
END

// Finish: side image and what to do next
IDD_FINISH DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_SIDE_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 173
    LTEXT           "Completed the CDS Editor Setup Wizard", IDC_HEADLINE, 107, 16, 175, 37
    LTEXT           "Click the Finish button to exit the Setup Wizard.", IDC_BODY, 107, 62, 175, 70
    CONTROL         "&Launch CDS Editor", IDC_OPT_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 107, 140, 175, 10
END

// Maintenance: repair or remove an installed copy
IDD_MAINTENANCE DIALOGEX 0, 0, 292, 173
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_SIDE_IMAGE, "Static", SS_OWNERDRAW, 0, 0, 292, 173
    LTEXT           "Change, repair, or remove installation", IDC_HEADLINE, 107, 16, 175, 37
    PUSHBUTTON      "&Repair", IDC_REPAIR, 107, 65, 60, 14
    LTEXT           "Repairs errors in the most recent installation by fixing missing and corrupt files, shortcuts, and registry entries.", IDC_REPAIR_NOTE, 107, 83, 175, 21
    PUSHBUTTON      "Re&move", IDC_REMOVE, 107, 108, 60, 14
    LTEXT           "Removes CDS Editor from your computer.", IDC_REMOVE_NOTE, 107, 127, 175, 21
END
