<?xml version="1.0" encoding="UTF-8"?>
<!--
  CDS Editor installer (WiX v6).
  Build: wix build -arch x64 -d BinDir=<folder with the exe and dll> -d SourceDir=<repo> -o cds-editor.msi cds_editor.wxs
  Shell integration never takes over .xml or .bin: the editor is offered under "Open with",
  the shell extension adds overlay badges and a context menu verb only to files whose content
  is a Definition File or a FACE configuration, and Default Programs lets the user opt in.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CDS Editor" Manufacturer="FACEOE" Version="1.0.0.0" Language="1033"
           UpgradeCode="01ADB398-6743-45F5-B841-75BDF9612E7B" Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of CDS Editor is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="EditorIcon" SourceFile="$(SourceDir)\examples\cds_editor.ico" />
    <Property Id="ARPPRODUCTICON" Value="EditorIcon" />
    <Property Id="ARPCOMMENTS" Value="Cockpit Display System editor: ARINC 661 Definition Files and FACE display management configurations." />
    <Property Id="ARPCONTACT" Value="FACEOE" />
    <Property Id="ARPHELPLINK" Value="https://github.com/faceoe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/faceoe" />

    <!-- No UI table: cds-setup.exe is the wizard; msiexec /i works with its basic UI and the
         properties INSTALLFOLDER and ADDLOCAL=Main,StartMenu,Desktop,OpenWith,ShellExt -->
    <!-- msiexec /i cds-editor.msi UPDATEURL=https://host/path/manifest.txt (or a UNC path) -->
    <Property Id="UPDATEURL" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CDS Editor">
        <Directory Id="ExamplesFolder" Name="examples" />
        <Directory Id="DocsFolder" Name="docs" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Features follow the Options page; Main is always installed -->
    <Feature Id="Main" Title="CDS Editor" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Application" />
      <ComponentGroupRef Id="Examples" />
    </Feature>
    <Feature Id="StartMenu" Title="Start menu shortcut" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="Desktop" Title="Desktop shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Feature Id="OpenWith" Title="Open With entries" Level="1">
      <ComponentRef Id="ProgIds" />
    </Feature>
    <Feature Id="ShellExt" Title="Explorer badges and menu" Level="1">
      <ComponentGroupRef Id="Shell" />
    </Feature>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="7C1C8E5A-5F0B-4D55-9E8B-3B0D6E3F1A01">
        <Shortcut Id="StartMenuShortcut" Name="CDS Editor" Description="Edit ARINC 661 Definition Files and FACE configurations" Target="[#EditorExe]" Icon="EditorIcon" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\FACEOE\CDS Editor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="7C1C8E5A-5F0B-4D55-9E8B-3B0D6E3F1A02">
        <Shortcut Id="DesktopShortcut" Name="CDS Editor" Description="Edit ARINC 661 Definition Files and FACE configurations" Target="[#EditorExe]" Icon="EditorIcon" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\FACEOE\CDS Editor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Component Id="Editor">
        <File Id="EditorExe" Source="$(BinDir)\cds-editor.exe" KeyPath="yes" />
        <!-- Where the shell extension finds the executable -->
        <RegistryValue Root="HKLM" Key="Software\FACEOE\CDS Editor" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Root="HKLM" Key="Software\FACEOE\CDS Editor" Name="UpdateUrl" Type="string" Value="[UPDATEURL]" />
      </Component>
      <Component Id="Help">
        <File Source="$(SourceDir)\docs\arinc661.chm" KeyPath="yes" />
      </Component>
      <Component Id="Readme">
        <File Source="$(SourceDir)\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Associations" Directory="INSTALLFOLDER">
      <Component Id="ProgIds">
        <RegistryKey Root="HKCR" Key="ARINC661.DefinitionFile">
          <RegistryValue Type="string" Value="ARINC 661 Definition File" KeyPath="yes" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]cds-editor.exe,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]cds-editor.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="FACEOE.Configuration">
          <RegistryValue Type="string" Value="FACE Display Management Configuration" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="[INSTALLFOLDER]cds-editor.exe,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]cds-editor.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
        <!-- Offered under "Open with"; the default handler of .xml and .bin is left alone -->
        <RegistryValue Root="HKCR" Key=".xml\OpenWithProgids" Name="ARINC661.DefinitionFile" Type="string" Value="" />
        <RegistryValue Root="HKCR" Key=".xml\OpenWithProgids" Name="FACEOE.Configuration" Type="string" Value="" />
        <RegistryValue Root="HKCR" Key=".bin\OpenWithProgids" Name="ARINC661.DefinitionFile" Type="string" Value="" />
        <!-- Default Programs: the user can choose the editor for .xml or .bin from Settings -->
        <RegistryKey Root="HKLM" Key="Software\FACEOE\CDS Editor\Capabilities">
          <RegistryValue Name="ApplicationName" Type="string" Value="CDS Editor" />
          <RegistryValue Name="ApplicationDescription" Type="string" Value="Edits ARINC 661 Definition Files and FACE display management configurations" />
          <RegistryValue Key="FileAssociations" Name=".xml" Type="string" Value="ARINC661.DefinitionFile" />
          <RegistryValue Key="FileAssociations" Name=".bin" Type="string" Value="ARINC661.DefinitionFile" />
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="CDS Editor" Type="string" Value="Software\FACEOE\CDS Editor\Capabilities" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shell" Directory="INSTALLFOLDER">
      <Component Id="ShellExtension">
        <File Id="ShellDll" Source="$(BinDir)\cds-shell.dll" KeyPath="yes" />
        <!-- COM classes -->
        <RegistryKey Root="HKCR" Key="CLSID\{B490275C-C09C-4CEC-91AD-3A9EEDE63F4E}">
          <RegistryValue Type="string" Value="ARINC 661 Definition File overlay" />
          <RegistryValue Key="InprocServer32" Type="string" Value="[INSTALLFOLDER]cds-shell.dll" />
          <RegistryValue Key="InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{A484FF8A-8CAE-41D2-B056-0B0BE5D884CC}">
          <RegistryValue Type="string" Value="FACE configuration overlay" />
          <RegistryValue Key="InprocServer32" Type="string" Value="[INSTALLFOLDER]cds-shell.dll" />
          <RegistryValue Key="InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
        <RegistryKey Root="HKCR" Key="CLSID\{FB3A3DF2-C819-45BF-9043-3E7E6C2BA68C}">
          <RegistryValue Type="string" Value="CDS Editor context menu" />
          <RegistryValue Key="InprocServer32" Type="string" Value="[INSTALLFOLDER]cds-shell.dll" />
          <RegistryValue Key="InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
        <!-- Overlay badges; leading spaces rank them ahead of other overlay handlers -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\  ARINC661Definition" Type="string" Value="{B490275C-C09C-4CEC-91AD-3A9EEDE63F4E}" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Explorer\ShellIconOverlayIdentifiers\  ARINC661Configuration" Type="string" Value="{A484FF8A-8CAE-41D2-B056-0B0BE5D884CC}" />
        <!-- Context menu verb on .xml and .bin, shown only when the content matches -->
        <RegistryValue Root="HKCR" Key="SystemFileAssociations\.xml\shellex\ContextMenuHandlers\CDSEditor" Type="string" Value="{FB3A3DF2-C819-45BF-9043-3E7E6C2BA68C}" />
        <RegistryValue Root="HKCR" Key="SystemFileAssociations\.bin\shellex\ContextMenuHandlers\CDSEditor" Type="string" Value="{FB3A3DF2-C819-45BF-9043-3E7E6C2BA68C}" />
        <!-- Approved for the shell -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{B490275C-C09C-4CEC-91AD-3A9EEDE63F4E}" Type="string" Value="ARINC 661 Definition File overlay" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{A484FF8A-8CAE-41D2-B056-0B0BE5D884CC}" Type="string" Value="FACE configuration overlay" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Approved" Name="{FB3A3DF2-C819-45BF-9043-3E7E6C2BA68C}" Type="string" Value="CDS Editor context menu" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Examples" Directory="ExamplesFolder">
      <Component Id="ExampleConfiguration">
        <File Source="$(SourceDir)\examples\arinc661_configuration.xml" KeyPath="yes" />
      </Component>
      <Component Id="ExampleDefinition">
        <File Source="$(SourceDir)\examples\arinc661_definition.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
